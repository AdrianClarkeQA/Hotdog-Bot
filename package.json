{
  "name": "discord-channel-archiver",
  "version": "1.0.0",
  "description": "Cloudflare Worker that auto-archives inactive Discord channels and restores them on activity.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "register": "node scripts/register-commands.js",
    "db:init": "wrangler d1 execute archiver-db --file=./schema.sql",
    "db:init:local": "wrangler d1 execute archiver-db --local --file=./schema.sql"
  },
  "dependencies": {
    "discord-interactions": "^4.1.0"
  },
  "devDependencies": {
    "wrangler": "^4.149.0"
  }
}
